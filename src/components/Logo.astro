---
import { Link } from 'accessible-astro-components'
import { Image } from 'astro:assets'
import themeConfig from '@theme-config'

interface Props {
  loading?: 'eager' | 'lazy'
}

const { loading = 'eager' }: Props = Astro.props
---

<Link
  href="/kupeace/"
  class="flex items-center gap-2 no-underline"
  style="text-decoration: none !important;"
>
  {
    themeConfig.logo && (
      <Image
        src={themeConfig.logo}
        alt={themeConfig.name}
        width="37"
        height="37"
        loading={loading}
      />
    )
  }
  <span class="flex flex-col leading-tight">
    <span class="text-sm font-bold sm:text-lg">{themeConfig.name}</span>
    <span class="text-xs font-medium sm:text-sm">PEACE stands for PEAk Campus Energy</span>
  </span>
</Link>
