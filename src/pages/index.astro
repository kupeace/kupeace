---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Heading, Link } from 'accessible-astro-components'
---

<DefaultLayout title="Kuvempu PEACE — Your Campus. Your Experience." useTitleTemplate={false}>
  <section class="relative overflow-hidden">
    <img
      src="/kupeace/images/hero-campus-view.jpg"
      alt="Misty view of the Kuvempu University campus surrounded by forest, with the Western Ghats hills in the background"
      class="w-full h-[60vh] object-cover"
    />
    <div class="container mx-auto py-16 text-center">
      <Heading level="h1" class="text-4xl md:text-6xl font-bold mb-4">Your Campus. Your Experience.</Heading>
      <p class="text-lg md:text-xl max-w-2xl mx-auto mb-8">
        A student-first guide to life at Kuvempu University — the campus, the forest it lives in, and everything in between.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <Link href="/kupeace/campus" class="px-6 py-3 rounded-lg bg-green-700 text-white font-semibold hover:bg-green-800">Explore the Campus</Link>
        <Link href="/kupeace/activities" class="px-6 py-3 rounded-lg border border-green-700 text-green-700 font-semibold hover:bg-green-50">See What's On</Link>
      </div>
    </div>
  </section>

  <section class="my-64">
    <div class="container">
      <Heading level="h2" class="mb-8 text-center">What You'll Find Here</Heading>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-lg shadow-md overflow-hidden bg-white">
          <img src="/kupeace/images/forest-laboratory-deer.jpg" alt="Spotted deer among trees in the forest surrounding the Kuvempu University campus" class="h-40 w-full object-cover" />
          <div class="p-6">
            <Heading level="h3" class="mb-2">My Forest Laboratory</Heading>
            <p>We're the only campus in India embedded in a tropical evergreen Western Ghats forest, right beside the Bhadra Tiger Reserve.</p>
          </div>
        </div>
        <div class="rounded-lg shadow-md overflow-hidden bg-white">
          <img src="https://picsum.photos/seed/kuvempu-clean-green/600/400" alt="Placeholder image for My Clean Campus" class="h-40 w-full object-cover" />
          <div class="p-6">
            <Heading level="h3" class="mb-2">My Clean Campus</Heading>
            <p>Meet the Clean Auditors — students partnering with our cleaning staff to keep our forest campus pristine.</p>
          </div>
        </div>
        <div class="rounded-lg shadow-md overflow-hidden bg-white">
          <img src="https://picsum.photos/seed/kuvempu-it-guide/600/400" alt="Placeholder image for IT Guide for Researchers" class="h-40 w-full object-cover" />
          <div class="p-6">
            <Heading level="h3" class="mb-2">IT Guide for Researchers</Heading>
            <p>Email etiquette, cloud tools, and AI literacy — the digital skills nobody teaches you, taught hands-on.</p>
          </div>
        </div>
        <div class="rounded-lg shadow-md overflow-hidden bg-white">
          <img src="https://picsum.photos/seed/kuvempu-research-tools/600/400" alt="Placeholder image for Research Tools and Productivity" class="h-40 w-full object-cover" />
          <div class="p-6">
            <Heading level="h3" class="mb-2">Research Tools &amp; Productivity</Heading>
            <p>R, Zotero, LibreOffice, and thesis templates — spend less time formatting, more time discovering.</p>
          </div>
        </div>
        <div class="rounded-lg shadow-md overflow-hidden bg-white">
          <img src="/kupeace/images/campus-cultural-event.jpg" alt="Students gathered for a candlelit cultural event on campus at night" class="h-40 w-full object-cover" />
          <div class="p-6">
            <Heading level="h3" class="mb-2">Activities &amp; Sign-Ups</Heading>
            <p>Treks, forest walks, workshops, and campus events — open to every student, every department.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="my-64 bg-green-50 py-16">
    <div class="container mx-auto text-center max-w-3xl">
      <blockquote class="text-2xl md:text-3xl italic font-medium">
        "The forest is not merely around the campus. The forest is part of the campus experience."
      </blockquote>
    </div>
  </section>
</DefaultLayout>
